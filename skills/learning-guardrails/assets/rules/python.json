    },
    "concurrency": {
      "diff": [
        "\\basyncio\\.\\w+|\\bTaskGroup\\b|\\banyio\\b|\\btrio\\b",
        "\\bthreading\\b|\\bmultiprocessing\\b|\\bconcurrent\\.futures\\b|\\b(Thread|Process)PoolExecutor\\b",
