        "\\blru_cache\\b|\\bcached_property\\b|@(functools\\.)?cache\\b",
        "\\.iterrows\\(\\)|\\.itertuples\\(\\)|\\.apply\\(\\s*lambda",
        "\\.collect\\(\\)|\\.to_?pandas\\(\\)|\\.(repartition|coalesce|persist|broadcast)\\("
      ]
    },
    "state": {
      "diff": [
        "^\\s*global\\s+\\w+",
        "\\bContextVar\\(|\\bcontextvars\\b|\\bthreading\\.local\\(",
        "@receiver\\(|\\b(pre|post)_(save|delete|init)\\b|\\bm2m_changed\\b",
        "\\bsession\\[|\\bflask\\.g\\b|\\bg\\.\\w+\\s*="
