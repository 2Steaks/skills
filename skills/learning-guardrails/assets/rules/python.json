{
  "pack": "python",
  "about": "Python: Django, Flask, FastAPI, SQLAlchemy, Celery, asyncio and data tooling.",
  "files": ["\\.(py|pyi|pyx|ipynb)$", "\\.(jinja2?|j2)$", "(^|/)templates/.+\\.(html?|txt|xml)$"],
  "categories": {
    "data": {
      "paths": ["(^|/)alembic/", "(^|/)models\\.py$"],
      "diff": [
        "\\.objects\\.\\w+",
        "\\b(session|db\\.session)\\.(execute|query|add|add_all|delete|merge|commit|flush|bulk_\\w+)\\(",
