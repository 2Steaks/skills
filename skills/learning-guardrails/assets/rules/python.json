    },
    "security": {
      "diff": [
        "\\bsubprocess\\b|\\bos\\.(system|popen|exec\\w*|spawn\\w*)\\(|shell\\s*=\\s*True",
        "\\bpickle\\.loads?\\(|\\bmarshal\\.loads?\\(|\\byaml\\.(load|unsafe_load|full_load)\\(|\\bshelve\\.open\\(",
        "\\bexec\\(|__import__\\(",
        "\\.(execute|executemany|raw)\\(\\s*f['\"]|\\.(execute|raw)\\(\\s*['\"][^'\"]*['\"]\\s*(%|\\.format\\()",
        "\\bmark_safe\\(|\\|\\s*safe\\b|\\bautoescape\\s+(off|false)\\b|\\bMarkup\\(|\\bformat_html\\(",
        "\\bverify\\s*=\\s*False\\b|\\bcsrf_exempt\\b|\\bDEBUG\\s*=\\s*True\\b|\\bALLOWED_HOSTS\\b|\\bpermission_classes\\b|@login_required\\b",
